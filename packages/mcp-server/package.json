{
  "name": "@bigstarter/mcp-server",
  "version": "0.1.0",
  "description": "The Kickstarter for vibe coding — MCP plugin for building in public with AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bigstarter": "./dist/cli/init.js",
    "bigstarter-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp", "ai-agents", "build-in-public", "vibe-coding",
    "kickstarter", "github", "claude", "bigstarter"
  ],
  "homepage": "https://github.com/BigFatDot/BigStarter",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigFatDot/BigStarter.git"
  },
  "license": "MIT",
  "files": ["dist", "README.md"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^21.0.0",
    "kuzu": "^0.7.1",
    "ulid": "^2.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
